{
  "name": "Budgie-web",
  "version": "1.0.0",
  "scripts": {
    "install-all": "npm install --prefix client && npm install --prefix server",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "concurrently": "^8.2.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express-oauth2-jwt-bearer": "^1.10.0",
    "firebase-admin": "^14.3.0",
    "jwks-rsa": "^4.1.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5"
  }
}
